# ==========================================
# CareerPulse Environment Variables Template
# ==========================================

# Supabase API (Client-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Admin (Serverless Functions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# SMTP Email Configuration (Nodemailer / Netlify Functions)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="CareerPulse Reminders" <your-email@gmail.com>
