# ==============================================================================
# JobFlow Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Client Configuration (Exposed to browser via Vite)
# ------------------------------------------------------------------------------
# Obtain from Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Server-Only Secrets for Netlify Serverless Functions
# IMPORTANT: Never prefix server-only secrets with VITE_ or commit them to Git.
# Configure these directly in your Netlify Dashboard -> Environment variables.
# ------------------------------------------------------------------------------

# Supabase Service Role Key (Required for automated scheduler to query due followups)
# Obtain from Supabase Project Settings -> API -> Project API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# SMTP / Transactional Email Provider Credentials
# Compatible with Gmail, SendGrid, Mailgun, Brevo (Sendinblue), Amazon SES, or any standard SMTP server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM="JobFlow Reminders <no-reply@jobflow.app>"
